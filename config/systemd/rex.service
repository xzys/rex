[Unit]
Description=Rex
After=systemd-user-sessions.service getty@tty2.service
Conflicts=getty@tty2.service emulationstation.service

[Service]
Type=simple
User=ark
WorkingDirectory=/home/ark
Environment=TERM=linux
ExecStart=/home/ark/bin/rex
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
ExecStartPost=+/usr/bin/chvt 2
ExecStopPost=+/usr/bin/chvt 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
