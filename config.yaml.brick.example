layout:
    gap: 4
    margin_x: 4
    margin_y: 2
    square_size: 9
apps:
    - name: claude
      icon: C
      color: "3"
      command: claude
      exclusive: false
    - name: codex
      icon: X
      color: "2"
      command: codex
      exclusive: false
    - name: pi
      icon: π
      color: "5"
      command: pi --no-tools
      exclusive: false
    - name: ssh
      icon: "~"
      color: "6"
      command: rex menu --ssh
    - name: settings
      icon: "*"
      color: "3"
      command: rex settings
ssh_hosts: []
keyboard_mode: chorded
