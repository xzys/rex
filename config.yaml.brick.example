layout:
    gap: 4
    margin_x: 4
    margin_y: 2
    square_size: 9
apps:
    - name: claude
      icon: C
      color: "3"
      command: claude
      exclusive: false
    - name: codex
      icon: X
      color: "2"
      command: codex
      exclusive: false
    - name: pi
      icon: π
      color: "5"
      command: pi --no-tools
      exclusive: false
    - name: zot
      icon: Z
      color: "6"
      command: zot
      exclusive: false
    - name: ncmpcpp
      icon: ♫
      color: "1"
      command: /home/rex/bin/ncmpcpp
      exclusive: false
    - name: lazygit
      icon: ¥
      color: "3"
      command: lazygit
      exclusive: false
    - name: lf
      icon: ≠
      color: "4"
      command: lf
      exclusive: false
    - name: games
      icon: ©
      color: "2"
      command: /userdata/system/apps/rex/emulationstation.sh
      exclusive: false
    - name: dictator
      icon: ●
      color: "1"
      command: rex dictator
      exclusive: false
    - name: ssh
      icon: "~"
      color: "6"
      command: rex menu --ssh
    - name: btm
      icon: ↓
      color: "5"
      command: btm
      exclusive: false
    - name: settings
      icon: "*"
      color: "8"
      command: rex settings
    - name: shutdown
      icon: ⏻
      color: "1"
      command: /userdata/system/apps/rex/shutdown.sh
ssh_hosts: []

# Keyboard input model: simple | chorded | chorded-simultaneous | front-chorded
keyboard_mode: chorded
# Keyboard layout: 4x8 | 3-row
keyboard_layout: 3-row
# 4x8 view: grid | fan. Ignored when keyboard_layout is 3-row.
keyboard_view: grid
