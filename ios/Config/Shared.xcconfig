// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = RexCompanion
PRODUCT_DISPLAY_NAME = Rex Companion
PRODUCT_BUNDLE_IDENTIFIER = com.rex.companion
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 26.0

// (1 == iPhone, 2 == iPad)
TARGETED_DEVICE_FAMILY = 1,2 

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeRight UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown
INFOPLIST_KEY_NSMicrophoneUsageDescription = Rex Companion needs microphone access for voice-to-text input
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = Rex Companion uses speech recognition to transcribe voice input
INFOPLIST_KEY_NSLocalNetworkUsageDescription = Rex Companion connects to the rex server on your local network

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/RexCompanion.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/RexCompanion.entitlements
